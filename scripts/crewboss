#!/bin/bash
# crewboss: spawn isolated agent sessions in worktrees and drive them from herdr.
set -u

CB_HOME=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/lib/naming.sh
. "$CB_HOME/lib/naming.sh"
# shellcheck source=scripts/lib/tree.sh
. "$CB_HOME/lib/tree.sh"
# shellcheck source=scripts/lib/pane.sh
. "$CB_HOME/lib/pane.sh"
# shellcheck source=scripts/lib/agent.sh
. "$CB_HOME/lib/agent.sh"
# shellcheck source=scripts/lib/registry.sh
. "$CB_HOME/lib/registry.sh"
# shellcheck source=scripts/lib/events.sh
. "$CB_HOME/lib/events.sh"

usage() {
  cat <<'EOF'
crewboss - spawn agent sessions on tasks, in isolated worktrees, visible in herdr

  crewboss spawn <task...>   [--in tab|space|split] [--agent KIND] [--branch NAME]
  crewboss list
  crewboss send  <name> <text...>
  crewboss wait  <name>...         wait for the first blocked or done crew event, then print it
  crewboss read  <name> [lines]
  crewboss focus <name>            jump herdr to that crew's pane
  crewboss close <name>            close the pane; worktree and conversation are kept
  crewboss open  <name>            reopen the pane and resume the conversation
  crewboss remove <name> [-f]      full teardown: pane, worktree, registry entry

remove refuses dirty or locally unpushed work. -f is explicit discard authority.
crewboss verifies the live pane before closing it and never spawns in the primary checkout.

The branch is derived from the task text: a Jira-style ticket key plus the first words become
<prefix>-ABC-123-short-description. No ticket means <prefix>-<slug>. --branch overrides.
The prefix comes from CB_PREFIX (default: your git user.name, lowercased).
EOF
}

die() { echo "crewboss: $*" >&2; exit 1; }

require_crew() {
  cb_reg_get "$1" >/dev/null 2>&1 || die "no crew named '$1' (crewboss list)"
}

do_spawn() {
  local placement=tab kind=claude branch="" task=""
  while [ $# -gt 0 ]; do
    case $1 in
      --in) placement=$2; shift 2 ;;
      --agent) kind=$2; shift 2 ;;
      --branch) branch=$2; shift 2 ;;
      *) task="$task${task:+ }$1"; shift ;;
    esac
  done
  [ -n "$task" ] || die "spawn needs a task"

  branch=$(cb_branch "$task" "$branch") || die "could not derive a branch from the task text"
  local name
  name=$(cb_name "$task")
  cb_reg_get "$name" >/dev/null 2>&1 && die "crew '$name' already exists (send, open, or remove it)"

  local tree pane crew_id run_id failure_status
  tree=$(cb_tree_create "$branch") || die "worktree creation failed for $branch"
  pane=$(cb_pane_create "$placement" "$tree" "$name") || die "could not create a herdr pane"
  cb_agent_start "$name" "$kind" "$pane" fresh || die "agent failed to start"
  crew_id=$(cb_id_new crew) || die "could not create crew identity"
  run_id=$(cb_id_new run) || die "could not create run identity"
  cb_reg_replace "$name" "$(jq -n --arg b "$branch" --arg p "$tree" --arg pane "$pane" \
    --arg k "$kind" --arg pl "$placement" --arg task "$task" \
    --arg crew_id "$crew_id" --arg run_id "$run_id" '
      {branch: $b, path: $p, pane: $pane, agent: $k, placement: $pl,
       status: "open", endpoint_state: "open", task: $task, latest_prompt: $task,
       crew_id: $crew_id, run_id: $run_id, task_status: "running",
       blocked: false, message: "", last_event_seq: 0}
    ')" || die "could not save crew state"
  if ! cb_agent_prompt "$name" "$task" "$crew_id" "$run_id" \
    "$CB_HOME/crewboss" "$CB_STATE_DIR"; then
    cb_reg_mark_prompt_unknown "$name" "$crew_id" "$run_id" 0
    failure_status=$?
    case $failure_status in
      0|2) die "could not send the task" ;;
      *) die "could not send the task and could not update crew state" ;;
    esac
  fi

  echo "spawned $name  branch=$branch  pane=$pane"
  echo "watch it in herdr, or: crewboss wait $name"
}

do_list() {
  cb_reg_init
  cb_event_pump || die "could not read crew events"
  local n record lifecycle pane endpoint reconcile_status
  for n in $(cb_reg_names); do
    record=$(cb_reg_get "$n") || die "could not read crew '$n'"
    lifecycle=$(jq -r '.status // empty' <<< "$record") || die "could not read crew '$n'"
    [ "$lifecycle" = open ] || continue
    pane=$(jq -r '.pane // empty' <<< "$record") || die "could not read crew '$n'"
    if [ -n "$pane" ]; then
      endpoint=$(cb_pane_status "$pane" "$n") || die "could not inspect crew '$n'"
    else
      endpoint=unknown
    fi
    cb_reg_reconcile_endpoint "$n" "$pane" "$endpoint"
    reconcile_status=$?
    case $reconcile_status in
      0|2) ;;
      *) die "could not update crew '$n'" ;;
    esac
  done

  local task_state branch summary
  printf '%-20s %-9s %-9s %-45s %s\n' NAME ENDPOINT TASK BRANCH SUMMARY
  for n in $(cb_reg_names); do
    record=$(cb_reg_get "$n") || die "could not read crew '$n'"
    endpoint=$(jq -r '
      if (.endpoint_state == "open" or .endpoint_state == "closed" or
          .endpoint_state == "unknown") then .endpoint_state else "unknown" end
    ' <<< "$record") || die "could not read crew '$n'"
    task_state=$(jq -r '
      if (.task_status == "running" or .task_status == "blocked" or
          .task_status == "done" or .task_status == "unknown")
      then .task_status else "unknown" end
    ' <<< "$record") || die "could not read crew '$n'"
    branch=$(jq -r '
      if ((.branch? | type) == "string" and (.branch | length) > 0)
      then .branch else "unknown" end
    ' <<< "$record") || die "could not read crew '$n'"
    summary=$(jq -r '
      if ((.task? | type) == "string" and (.task | length) > 0) then
        .task | gsub("[\\r\\n\\t]+"; " ") | gsub(" +"; " ") |
        sub("^ +"; "") | sub(" +$"; "") |
        if length == 0 then "unknown"
        elif length > 60 then .[0:57] + "..."
        else . end
      else "unknown" end
    ' <<< "$record") || die "could not read crew '$n'"
    printf '%-20s %-9s %-9s %-45s %s\n' \
      "$n" "$endpoint" "$task_state" "$branch" "$summary"
  done
}

do_send() {
  local name=$1; shift
  require_crew "$name"
  [ "$(cb_reg_field "$name" status)" = open ] || die "'$name' is closed (crewboss open $name)"
  [ $# -gt 0 ] || die "send needs text"
  local prompt=$* candidate_crew_id crew_id run_id receipt finish_status
  candidate_crew_id=$(cb_id_new crew) || die "could not create crew identity"
  run_id=$(cb_id_new run) || die "could not create run identity"
  cb_reg_send_begin "$name" "$candidate_crew_id" "$run_id" "$prompt" ||
    die "could not prepare the crew state"
  receipt=$CB_REG_SEND_RECEIPT
  crew_id=$(jq -r '.crew_id' <<< "$receipt") || die "could not read the crew identity"

  if cb_agent_prompt "$name" "$prompt" "$crew_id" "$run_id" \
    "$CB_HOME/crewboss" "$CB_STATE_DIR"; then
    cb_reg_send_finish "$name" "$receipt" success ||
      die "task was sent but the crew state changed before delivery finished"
  else
    cb_reg_send_finish "$name" "$receipt" failure
    finish_status=$?
    case $finish_status in
      0) die "could not send" ;;
      2) die "could not send; crew state changed while delivery was in progress" ;;
      *) die "could not send and could not restore the previous crew state" ;;
    esac
  fi
  echo "sent; crewboss wait $name"
}

do_wait() {
  local name event crew kind
  for name in "$@"; do
    require_crew "$name"
  done
  event=$(cb_event_next "$@") || die "could not read crew events"
  crew=$(jq -r '.crew' <<< "$event") || die "could not read crew event"
  kind=$(jq -r '.kind' <<< "$event") || die "could not read crew event"

  printf '%s %s\n' "$crew" "$kind" || return 1
  jq -r '.payload' <<< "$event" || return 1
  cb_event_ack "$event" ||
    die "event was printed but could not be acknowledged; wait may print it again"
}

do_read() {
  require_crew "$1"
  cb_agent_read "$1" "${2:-200}"
}

do_focus() {
  local target
  require_crew "$1"
  [ "$(cb_reg_field "$1" status)" = open ] || die "'$1' is closed (crewboss open $1)"
  target=$(cb_agent_target "$1") || return 1
  herdr agent focus "$target" >/dev/null
}

close_crew() {
  local name=$1
  cb_pane_close "$(cb_reg_field "$name" pane)" "$name" ||
    die "could not safely close '$name'"
  cb_reg_put "$name" '{"status": "closed", "endpoint_state": "closed"}' ||
    die "could not update the crew registry"
}

do_close() {
  require_crew "$1"
  [ "$(cb_reg_field "$1" status)" = open ] || die "'$1' is already closed"
  close_crew "$1"
  echo "closed $1 (worktree and conversation kept; crewboss open $1 to resume)"
}

do_open() {
  local name=$1 tree kind placement pane
  require_crew "$name"
  [ "$(cb_reg_field "$name" status)" = closed ] || die "'$name' is already open"
  tree=$(cb_reg_field "$name" path)
  kind=$(cb_reg_field "$name" agent)
  placement=$(cb_reg_field "$name" placement)
  pane=$(cb_pane_create "$placement" "$tree" "$name") || die "could not create a herdr pane"
  cb_agent_start "$name" "$kind" "$pane" resume || die "agent failed to resume"
  cb_reg_put "$name" "$(jq -n --arg p "$pane" \
    '{pane: $p, status: "open", endpoint_state: "open"}')" ||
    die "could not update the crew registry"
  echo "reopened $name  pane=$pane (conversation resumed)"
}

do_remove() {
  if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    die "usage: crewboss remove <name> [-f]"
  fi
  local name=$1 force=${2:-} branch path crew_id
  [ -z "$force" ] || [ "$force" = -f ] ||
    die "usage: crewboss remove <name> [-f]"

  require_crew "$name"
  branch=$(cb_reg_field "$name" branch)
  path=$(cb_reg_field "$name" path)
  crew_id=$(cb_reg_field "$name" crew_id)
  cb_tree_check_remove "$branch" "$path" "$force" ||
    die "refusing to remove '$name'"

  if [ "$(cb_reg_field "$name" status)" = open ]; then
    close_crew "$name"
  fi

  cb_tree_check_remove "$branch" "$path" "$force" ||
    die "'$name' changed while closing; worktree kept (crewboss open $name)"
  cb_tree_remove "$branch" "$force" ||
    die "worktree removal failed; crew kept closed (crewboss open $name)"
  if [ -n "$crew_id" ]; then
    cb_event_drop_crew "$crew_id" ||
      die "worktree removed but pending event cleanup failed"
  fi
  cb_reg_del "$name" || die "worktree removed but registry cleanup failed"
  echo "removed $name"
}

do_emit() {
  cb_event_emit "$@" || die "could not append crew event"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  spawn)  do_spawn "$@" ;;
  list)   do_list ;;
  send)   [ $# -ge 2 ] || die "usage: crewboss send <name> <text...>"; do_send "$@" ;;
  wait)   [ $# -ge 1 ] || die "usage: crewboss wait <name>..."; do_wait "$@" ;;
  read)   [ $# -ge 1 ] || die "usage: crewboss read <name> [lines]"; do_read "$@" ;;
  focus)  [ $# -ge 1 ] || die "usage: crewboss focus <name>"; do_focus "$1" ;;
  close)  [ $# -ge 1 ] || die "usage: crewboss close <name>"; do_close "$1" ;;
  open)   [ $# -ge 1 ] || die "usage: crewboss open <name>"; do_open "$1" ;;
  remove) do_remove "$@" ;;
  emit)   [ $# -eq 5 ] || die "invalid crew event"; do_emit "$@" ;;
  help|--help|-h) usage ;;
  *) usage; exit 2 ;;
esac
